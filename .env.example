# Copy this file to .env for a local Community Edition installation.

# SQLite database created locally on first startup or bootstrap.
APP_DATABASE_PATH=data/selfecho.db

# Registration stays closed by default. Create the first user with:
#   python -m app.bootstrap
AUTH_REGISTRATION_MODE=closed
# Optional SHA-256 digest used only after switching registration mode to invite.
# Never store the raw invite code in this file.
AUTH_INVITE_CODE_HASH=

# Use one origin consistently for the browser, server, and Origin validation.
APP_ORIGIN=http://127.0.0.1:8000
AUTH_SESSION_EXPIRATION_SECONDS=2592000
# Local HTTP uses a non-Secure local session cookie name. For an HTTPS deployment,
# set this to true and change APP_ORIGIN to the public HTTPS origin; the server will
# then use a Secure __Host- session cookie with no Domain and Path=/.
AUTH_COOKIE_SECURE=false

# AI is optional for initial bootstrap and login. Add your own provider key before
# using AI structuring. Keys are read by the backend and must never be committed.
AI_PROVIDER=deepseek
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-v4-flash
DEEPSEEK_API_URL=https://api.deepseek.com
AI_TIMEOUT_SECONDS=30
# Development diagnostics may contain personal input or model output.
AI_DEBUG_OUTPUT=false

# Optional OpenAI Responses API provider. Used when AI_PROVIDER=openai.
AI_API_URL=https://api.openai.com/v1/responses
AI_API_KEY=
AI_MODEL=

# Reminders work without the background worker: due reminders surface in the app
# on the next visit. The embedded worker is only needed for scheduled Web Push
# delivery and supports a single enabled application instance.
REMINDER_WORKER_ENABLED=false
REMINDER_POLL_INTERVAL_SECONDS=30
REMINDER_BATCH_SIZE=100
# Deliveries stuck in "sending" longer than this are reconciled to "unknown".
REMINDER_SENDING_STALE_SECONDS=300

# Optional Web Push is disabled by default. Scheduled Push requires both
# WEB_PUSH_ENABLED=true and an enabled Reminder worker. As the self-host operator,
# generate your own VAPID key pair; the private key must remain secret and is never
# committed. WEB_PUSH_VAPID_SUBJECT is a mailto: or https: contact URI.
WEB_PUSH_ENABLED=false
WEB_PUSH_VAPID_PUBLIC_KEY=
WEB_PUSH_VAPID_PRIVATE_KEY=
WEB_PUSH_VAPID_SUBJECT=
WEB_PUSH_TIMEOUT_SECONDS=10
# Diagnostic test notification; usable only while Web Push is enabled.
WEB_PUSH_TEST_SEND_ENABLED=false
