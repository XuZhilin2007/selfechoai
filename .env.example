# Copy this file to .env for a local Community Edition installation.

# SQLite database created locally on first startup or bootstrap.
APP_DATABASE_PATH=data/selfecho.db

# Registration stays closed by default. Create the first user with:
#   python -m app.bootstrap
AUTH_REGISTRATION_MODE=closed
# Optional SHA-256 digest used only after switching registration mode to invite.
# Never store the raw invite code in this file.
AUTH_INVITE_CODE_HASH=

# Use one origin consistently for the browser, server, and Origin validation.
APP_ORIGIN=http://127.0.0.1:8000
AUTH_SESSION_EXPIRATION_SECONDS=2592000
# Local HTTP uses a non-Secure local session cookie name. For an HTTPS deployment,
# set this to true and change APP_ORIGIN to the public HTTPS origin; the server will
# then use a Secure __Host- session cookie with no Domain and Path=/.
AUTH_COOKIE_SECURE=false

# Bounded, process-local admission for register/login attempts: per source,
# per account, and globally, enforced before password hashing or any write.
# These are finite community fallbacks; the values are not Hosted capacity policy.
AUTH_REGISTRATION_WINDOW_SECONDS=60
AUTH_REGISTRATION_SOURCE_LIMIT=20
AUTH_REGISTRATION_GLOBAL_LIMIT=100
AUTH_LOGIN_WINDOW_SECONDS=60
AUTH_LOGIN_SOURCE_LIMIT=30
AUTH_LOGIN_ACCOUNT_LIMIT=10
AUTH_LOGIN_GLOBAL_LIMIT=300
AUTH_ADMISSION_MAX_KEYS=1024

# AI is optional for initial bootstrap and login. Add your own provider key before
# using AI structuring. Keys are read by the backend and must never be committed.
AI_PROVIDER=deepseek
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-flash
DEEPSEEK_API_URL=https://api.deepseek.com
AI_TIMEOUT_SECONDS=30
# Development diagnostics may contain personal input or model output.
AI_DEBUG_OUTPUT=false

# Bounded, process-local admission before each outbound AI/ASR provider call,
# plus a bound on the provider-bound AI request body. Denied work keeps the
# original user input saved locally.
AI_ADMISSION_WINDOW_SECONDS=60
AI_ADMISSION_CALL_LIMIT=60
AI_ADMISSION_CONCURRENT_LIMIT=4
AI_PROVIDER_INPUT_MAX_BYTES=1000000
ASR_ADMISSION_WINDOW_SECONDS=60
ASR_ADMISSION_CALL_LIMIT=30
ASR_ADMISSION_CONCURRENT_LIMIT=4

# Persistent-storage admission: reserve real free disk space before new
# database content or Voice Original Audio is written, bound Voice recording
# concurrency, and bound extra_information growth. Rejections never modify or
# discard already saved content.
STORAGE_MIN_FREE_BYTES=67108864
STORAGE_WRITE_WINDOW_SECONDS=60
STORAGE_WRITE_LIMIT=120
STORAGE_VOICE_CONCURRENT_LIMIT=4
STORAGE_ITEM_EXTRA_MAX_BYTES=262144

# Optional OpenAI Responses API provider. Used when AI_PROVIDER=openai.
AI_API_URL=https://api.openai.com/v1/responses
AI_API_KEY=
AI_MODEL=

# Reminders work without the background worker: due reminders surface in the app
# on the next visit. The embedded worker is needed for scheduled Web Push or
# Email delivery and supports a single enabled application instance.
REMINDER_WORKER_ENABLED=false
REMINDER_POLL_INTERVAL_SECONDS=30
REMINDER_BATCH_SIZE=100
# Deliveries stuck in "sending" longer than this are reconciled to "unknown".
REMINDER_SENDING_STALE_SECONDS=300

# Trash retention runs inside the application process. Expired Trash items are
# permanently deleted in bounded batches; 30 days is fixed in v0.7.0.
TRASH_RETENTION_POLL_INTERVAL_SECONDS=3600
TRASH_RETENTION_BATCH_SIZE=100

# Optional Web Push is disabled by default. Scheduled Push requires both
# WEB_PUSH_ENABLED=true and an enabled Reminder worker. As the self-host operator,
# generate your own VAPID key pair; the private key must remain secret and is never
# committed. WEB_PUSH_VAPID_SUBJECT is a mailto: or https: contact URI.
WEB_PUSH_ENABLED=false
WEB_PUSH_VAPID_PUBLIC_KEY=
WEB_PUSH_VAPID_PRIVATE_KEY=
WEB_PUSH_VAPID_SUBJECT=
WEB_PUSH_TIMEOUT_SECONDS=10
# Diagnostic test notification; usable only while Web Push is enabled.
WEB_PUSH_TEST_SEND_ENABLED=false

# Optional Tencent SES Email Reminder channel. It is disabled by default, so
# unused Email-specific values are not parsed and no Tencent credentials are
# required for normal startup. When enabled, use your own Tencent account,
# verified sender identity, templates, and a high-entropy verification pepper.
# The normal Reminder template receives only {"app_url": "<APP_ORIGIN>/dashboard"};
# it never receives a Personal Item title, item ID, or item-specific URL.
EMAIL_REMINDER_PROVIDER_ENABLED=false
TENCENT_SES_REGION=ap-guangzhou
TENCENTCLOUD_SECRET_ID=
TENCENTCLOUD_SECRET_KEY=
TENCENT_SES_FROM_EMAIL_ADDRESS=
TENCENT_SES_VERIFICATION_TEMPLATE_ID=
TENCENT_SES_REMINDER_TEMPLATE_ID=
# Optional dedicated template used only by the Account-page Test Email action.
TENCENT_SES_TEST_TEMPLATE_ID=
TENCENT_SES_TIMEOUT_SECONDS=10
EMAIL_VERIFICATION_CODE_PEPPER=

# Bounded, process-local admission for outbound verification and reminder
# emails: per recipient and globally. Rejections are explicit and carry
# Retry-After; no local challenge state is created for a denied send.
EMAIL_VERIFICATION_RECIPIENT_WINDOW_SECONDS=3600
EMAIL_VERIFICATION_RECIPIENT_LIMIT=5
EMAIL_VERIFICATION_RECIPIENT_MAX_KEYS=1024
EMAIL_SEND_WINDOW_SECONDS=60
EMAIL_SEND_GLOBAL_LIMIT=60

# Email addresses, verification challenge metadata, and delivery metadata are
# stored in the self-host database. Tencent receives the recipient address and
# verification code for verification messages; normal reminders contain only
# generic SelfEcho text and the generic app/dashboard URL.

# Optional Voice Capture (press-and-hold speech-to-text). Disabled by default;
# text Capture, auth, Reminders and Push all work without it. Enabling requires
# an absolute writable storage path outside the Git checkout plus operator-installed
# ffmpeg/ffprobe and your own Alibaba DashScope credential.
VOICE_ASR_ENABLED=false

# Required when Voice is enabled. Voice Original Audio is stored here, outside
# SQLite. Keep the path writable, protect it like the database, and back it up
# with the database. Disabling Voice later does not delete stored audio.
VOICE_STORAGE_ROOT=

# Maximum Voice upload size: 16 MiB.
VOICE_MAX_UPLOAD_BYTES=16777216

# Operator-installed media tools used to inspect and normalize recordings.
# SelfEcho does not bundle or redistribute them. Required only when Voice is enabled.
FFPROBE_PATH=
FFMPEG_PATH=

# Alibaba DashScope ASR endpoint and credential. Supply your own key; it is read
# by the backend and must never be committed. Used only for Voice transcription.
ALIBABA_ASR_API_URL=https://dashscope.aliyuncs.com/api/v1/services/aigc/multimodal-generation/generation
ALIBABA_API_KEY=
VOICE_ASR_TIMEOUT_SECONDS=30
